<UserControl x:Class="Screen2VMS.App.Views.CameraTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Screen2VMS.App.ViewModels"
             xmlns:views="clr-namespace:Screen2VMS.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CameraTileViewModel}"
             Width="340">
    <Border Style="{StaticResource Panel}" Margin="0,0,16,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: name and per-camera actions -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource SectionHeading}"
                               Margin="0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Camera not found - it may be unplugged"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="10"
                               Visibility="{Binding DeviceMissing, Converter={StaticResource BooleanToVisible}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding StartCommand}" MinWidth="60" Padding="10,5" Margin="0,0,6,0" />
                    <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="60" Padding="10,5" Margin="0,0,6,0" />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" MinWidth="0" Padding="10,5" ToolTip="Remove this camera" />
                </StackPanel>
            </Grid>

            <!-- Live preview -->
            <Border Grid.Row="1"
                    Background="Black"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <TextBlock Text="No preview"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsRunning, Converter={StaticResource BooleanToCollapsed}}" />
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="4" />
                </Grid>
            </Border>

            <!-- Status line -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="10"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />

            <!-- Details: resolution/frame rate, component health, VMS connection info -->
            <Expander Grid.Row="3"
                      Header="Details"
                      Foreground="{StaticResource SecondaryText}"
                      FontSize="11"
                      Margin="0,8,0,0">
                <StackPanel Margin="0,10,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Resolutions}"
                                      SelectedItem="{Binding SelectedResolution}"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding FrameRates}"
                                      SelectedItem="{Binding SelectedFrameRate}"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,4,0,10" Background="{StaticResource PanelBorder}" />

                    <views:StatusRow Label="Camera" State="{Binding CameraState}" Detail="{Binding CameraDetail}" />
                    <views:StatusRow Label="Encoder" State="{Binding EncoderState}" Detail="{Binding EncoderDetail}" />
                    <views:StatusRow Label="RTSP" State="{Binding RtspState}" Detail="{Binding RtspDetail}" />
                    <views:StatusRow Label="ONVIF" State="{Binding OnvifState}" Detail="{Binding OnvifDetail}" />
                    <views:StatusRow Label="Discovery" State="{Binding DiscoveryState}" Detail="{Binding DiscoveryDetail}" />

                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Clients" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientCountText}" Style="{StaticResource ValueText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Capture rate" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeasuredFpsText}" Style="{StaticResource ValueText}" />
                    </Grid>

                    <Separator Margin="0,0,0,10" Background="{StaticResource PanelBorder}" />

                    <TextBlock Text="ONVIF address" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OnvifUri, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" />
                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyOnvifUriCommand}" MinWidth="52" Padding="8,4" Margin="6,0,0,12" />
                    </Grid>

                    <TextBlock Text="RTSP address" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding StreamUri, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" />
                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyStreamUriCommand}" MinWidth="52" Padding="8,4" Margin="6,0,0,12" />
                    </Grid>

                    <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding OnvifUserName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" />

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OnvifPassword, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Style="{StaticResource Field}" />
                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyPasswordCommand}" MinWidth="52" Padding="8,4" Margin="6,0,0,12" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Grid>
    </Border>
</UserControl>
