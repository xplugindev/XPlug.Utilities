<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio's equivalent of tools/Publish.ps1: one self-contained
  Screen2VMS.exe in Screen2VMS/dist, no runtime or files needed beside it.
  Right-click Screen2VMS.App > Publish > FolderProfile > Publish.

  Keep these switches in step with Publish.ps1. They live in a profile rather
  than the .csproj because a RuntimeIdentifier in the project would move every
  ordinary build into a win-x64 subfolder.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\dist\</PublishDir>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Without these the native WPF and Media Foundation shims land beside the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- CoreWCF, the XML serialisers and WPF resolve types by reflection; trimming breaks them at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Exactly one file: no .pdb, no localisation folders. A profile's
         properties, unlike Publish.ps1's -p: switches, do not reach referenced
         projects, so their .pdb files are excluded from the copy instead. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
