<Window x:Class="Screen2VMS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Screen2VMS.App.ViewModels"
        Title="Screen2VMS"
        Height="600"
        Width="960"
        MinHeight="520"
        MinWidth="820"
        Background="{StaticResource WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Text="Screen2VMS"
                   Foreground="{StaticResource PrimaryText}"
                   FontSize="20"
                   FontWeight="Light"
                   Margin="0,0,0,16" />

        <!-- Camera selection -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Source" Style="{StaticResource SectionHeading}" />

                <TextBlock Text="Camera" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Resolutions}"
                          SelectedItem="{Binding SelectedResolution}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding FrameRates}"
                          SelectedItem="{Binding SelectedFrameRate}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                <Separator Margin="0,4,0,16" Background="{StaticResource PanelBorder}" />

                <TextBlock Text="Status" Style="{StaticResource SectionHeading}" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9"
                             Height="9"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StateText}"
                               Style="{StaticResource ValueText}"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding ActiveModeText}" Style="{StaticResource ValueText}" TextWrapping="Wrap" />

                <TextBlock Text="Measured rate" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding MeasuredFpsText}" Style="{StaticResource ValueText}" />

                <TextBlock Text="Frames" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding FramesText}" Style="{StaticResource ValueText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Background="Black"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <TextBlock Text="No preview"
                           Foreground="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsRunning, Converter={StaticResource BooleanToCollapsed}}" />
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="8" />
            </Grid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Start"
                    Command="{Binding StartCommand}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="1"
                    Content="Stop"
                    Command="{Binding StopCommand}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource ValueText}"
                       Foreground="{StaticResource SecondaryText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="16,0" />

            <Button Grid.Column="4"
                    Content="View Logs"
                    Command="{Binding OpenLogsCommand}" />
        </Grid>
    </Grid>
</Window>
