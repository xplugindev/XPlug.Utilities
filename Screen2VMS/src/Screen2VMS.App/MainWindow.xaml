<Window x:Class="Screen2VMS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Screen2VMS.App.ViewModels"
        xmlns:views="clr-namespace:Screen2VMS.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Screen2VMS"
        Height="720"
        Width="1080"
        MinHeight="620"
        MinWidth="900"
        Background="{StaticResource WindowBackground}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="Screen2VMS"
                       Foreground="{StaticResource PrimaryText}"
                       FontSize="20"
                       FontWeight="Light" />
            <TextBlock Text="Presents this webcam to Genetec and Milestone XProtect as an ONVIF camera"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Left: source and status -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Source" Style="{StaticResource SectionHeading}" />

                        <TextBlock Text="Camera" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                        <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding FrameRates}"
                                  SelectedItem="{Binding SelectedFrameRate}"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}" />

                        <TextBlock Text="Bitrate (kbps)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BitrateKbps, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"
                                 Style="{StaticResource Field}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource SectionHeading}" />

                        <views:StatusRow Label="Camera" State="{Binding CameraState}" Detail="{Binding CameraDetail}" />
                        <views:StatusRow Label="Encoder" State="{Binding EncoderState}" Detail="{Binding EncoderDetail}" />
                        <views:StatusRow Label="RTSP" State="{Binding RtspState}" Detail="{Binding RtspDetail}" />
                        <views:StatusRow Label="ONVIF" State="{Binding OnvifState}" Detail="{Binding OnvifDetail}" />
                        <views:StatusRow Label="Discovery" State="{Binding DiscoveryState}" Detail="{Binding DiscoveryDetail}" />

                        <Separator Margin="0,10" Background="{StaticResource PanelBorder}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Clients" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientCountText}" Style="{StaticResource ValueText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Capture rate" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeasuredFpsText}" Style="{StaticResource ValueText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Stream bitrate" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeasuredBitrateText}" Style="{StaticResource ValueText}" />
                        </Grid>

                        <TextBlock Text="Frames" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding FramesText}" Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Right: preview and connection details -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Black"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <TextBlock Text="No preview"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsRunning, Converter={StaticResource BooleanToCollapsed}}" />
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="8" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Add this camera to your VMS" Style="{StaticResource SectionHeading}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ONVIF address" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OnvifUri, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Copy" Command="{Binding CopyOnvifUriCommand}" MinWidth="64" Margin="8,0,0,12" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="RTSP address" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StreamUri, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Copy" Command="{Binding CopyStreamUriCommand}" MinWidth="64" Margin="8,0,0,12" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="User name" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OnvifUserName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OnvifPassword, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Style="{StaticResource Field}" />
                        <Button Grid.Row="3" Grid.Column="2" Content="Copy" Command="{Binding CopyPasswordCommand}" MinWidth="64" Margin="8,0,0,12" />
                    </Grid>

                    <TextBlock Text="This password is unique to this installation and is stored encrypted."
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Start" Command="{Binding StartCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" />

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource ValueText}"
                       Foreground="{StaticResource SecondaryText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="16,0" />

            <Button Grid.Column="4" Content="Firewall Rules" Command="{Binding CreateFirewallRulesCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="5" Content="View Logs" Command="{Binding OpenLogsCommand}" />
        </Grid>
    </Grid>
</Window>
