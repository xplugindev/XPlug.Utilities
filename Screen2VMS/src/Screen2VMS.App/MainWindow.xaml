<Window x:Class="Screen2VMS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Screen2VMS.App.ViewModels"
        xmlns:views="clr-namespace:Screen2VMS.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Screen2VMS"
        Height="800"
        Width="1280"
        MinHeight="620"
        MinWidth="900"
        Background="{StaticResource WindowBackground}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="Screen2VMS"
                       Foreground="{StaticResource PrimaryText}"
                       FontSize="20"
                       FontWeight="Light" />
            <TextBlock Text="Presents each selected camera to Genetec and Milestone XProtect as its own ONVIF camera"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Left: add a camera -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Add a camera" Style="{StaticResource SectionHeading}" />

                        <TextBlock Text="Camera" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AvailableDevices}"
                                  SelectedItem="{Binding DeviceToAdd}"
                                  DisplayMemberPath="Name" />

                        <Button Content="Add camera"
                                Command="{Binding AddCameraCommand}"
                                HorizontalAlignment="Stretch" />

                        <TextBlock Text="Every camera you add is published as its own, independent ONVIF device and RTSP stream."
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="10"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="All cameras" Style="{StaticResource SectionHeading}" />

                        <Button Content="Start All" Command="{Binding StartAllCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <Button Content="Stop All" Command="{Binding StopAllCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <Button Content="Firewall Rules" Command="{Binding CreateFirewallRulesCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <Button Content="Refresh Devices" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <Button Content="View Logs" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: multi-camera live grid -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <TextBlock Text="No cameras yet. Add one on the left to see it here."
                           Foreground="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding NoCamerasConfigured, Converter={StaticResource BooleanToVisible}}" />

                <ItemsControl ItemsSource="{Binding Cameras}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CameraTileView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource ValueText}"
                       Foreground="{StaticResource SecondaryText}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
